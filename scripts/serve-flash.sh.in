#!/usr/bin/env bash
# Foreground launch of the oMLX flash 8-slot server (rendered by setup.sh).
# For boot persistence use the launchd plist instead — not both (port conflict
# kills the newcomer while the old server keeps serving, see docs/TRAPS.md).
exec @OMLX@ serve --model-dir @MODELDIR@ --host 127.0.0.1 --port @PORT@ \
  --max-concurrent-requests 8 \
  --paged-ssd-cache-dir @HOME@/.omlx/ssd-cache
